{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "tech-blue",
          "name": "Tech Blue",
          "color": "#2563eb"
        },
        {
          "slug": "navy",
          "name": "Navy",
          "color": "#0f172a"
        },
        {
          "slug": "ice",
          "name": "Ice",
          "color": "#f1f5f9"
        },
        {
          "slug": "white",
          "name": "White",
